{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command",
            "command": "\"$CLAUDE_PLUGIN_ROOT/hooks/session-start.sh\"",
            "shell": "bash",
            "timeout": 20 },
          { "type": "command",
            "command": "& \"$env:CLAUDE_PLUGIN_ROOT/hooks/session-start.ps1\"",
            "shell": "powershell",
            "timeout": 20 }
        ]
      }
    ]
  }
}
